<ContentDialog
    x:Class="scarpa_connection_manager_win.Dialogs.PassphraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonText="OK"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="12" Width="350">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <PasswordBox x:Name="PassphraseInput" PlaceholderText="Passphrase" />
        <PasswordBox x:Name="ConfirmInput" PlaceholderText="Confirm Passphrase" Visibility="Collapsed" />
        <CheckBox x:Name="RememberCheck" Content="Remember master passphrase" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>