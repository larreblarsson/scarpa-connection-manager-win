<ContentDialog
    x:Class="scarpa_connection_manager_win.Dialogs.PassphraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Master passphrase"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="White" />
    </ContentDialog.Resources>

    <StackPanel Spacing="16" Width="350">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <PasswordBox x:Name="PassBox" />
        <CheckBox x:Name="RememberCheck" Content="Remember master passphrase" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>