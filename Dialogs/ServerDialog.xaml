<Window
    x:Class="scarpa_connection_manager_win.Dialogs.ServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        </Grid.Resources>

        <!-- Main Content Area -->
        <NavigationView x:Name="NavView" Grid.Row="0" PaneDisplayMode="Left" OpenPaneLength="180" Background="Transparent" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="General" Content="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Terminal" Content="Terminal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="LoginAction" Content="Login Action">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="PortForwarding" Content="Port Forwarding">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Appearance" Content="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="RDP" Content="RDP">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE836;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Border Background="Transparent" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">

                    <!-- MinWidth="580" forces all tabs to perfectly match the Terminal page width -->
                    <Grid MinWidth="580">

                        <!-- 1. GENERAL PAGE -->
                        <StackPanel x:Name="GeneralPage" Spacing="16">
                            <TextBox x:Name="NameBox" Header="Display name" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HostBox" Header="Host / IP" Grid.Column="0" />
                                <TextBox x:Name="PortBox" Header="Port" Text="22" Grid.Column="1" />
                            </Grid>

                            <ComboBox x:Name="FolderBox" Header="Folder" IsEditable="True" HorizontalAlignment="Stretch" />

                            <TextBox x:Name="UserBox" Header="Username" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="AuthMethodBox" Header="Authentication" HorizontalAlignment="Stretch" Grid.Column="0" SelectionChanged="AuthMethodBox_SelectionChanged">
                                    <ComboBoxItem Content="password" />
                                    <ComboBoxItem Content="ask" />
                                    <ComboBoxItem Content="key_file" />
                                </ComboBox>
                                <PasswordBox x:Name="PassBox" Header="Password" Grid.Column="1" />
                            </Grid>

                            <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed" Margin="166,-8,0,0" MinWidth="0" />

                            <StackPanel x:Name="KeyFilePanel" Visibility="Collapsed" Spacing="4">
                                <TextBlock Text="Private Key File" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="KeyFileBox" Grid.Column="0" />
                                    <Button Content="Browse" Click="BrowseKeyFile_Click" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. TERMINAL PAGE -->
                        <StackPanel x:Name="TerminalPage" Spacing="16" Visibility="Collapsed">
                            <ToggleSwitch x:Name="EnableLoggingSwitch" Header="Enable session logging" />

                            <TextBlock Text="Log file folder path" Margin="0,0,0,-12" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LogPathTextBox" PlaceholderText="C:\Logs\session.txt" Grid.Column="0" VerticalAlignment="Center" />
                                <Button Content="Browse" Click="BrowseLogPath_Click" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <TextBlock Text="Mode:" VerticalAlignment="Center" />
                                <RadioButton x:Name="AppendRadio" Content="Append to file" GroupName="LogMode" />
                                <RadioButton x:Name="OverwriteRadio" Content="Overwrite file" GroupName="LogMode" />
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <CheckBox x:Name="AppendDataCheck" Content="Append Data to Log" MinWidth="0" />

                                <Grid ColumnSpacing="12" RowSpacing="12" Margin="24,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="At connect:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                                    <TextBox x:Name="LogConnectBox" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Text="At disconnect:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                                    <TextBox x:Name="LogDisconnectBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Text="On each line:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                                    <TextBox x:Name="LogEachLineBox" Grid.Row="2" Grid.Column="1" />
                                </Grid>

                                <TextBlock Text="Substitutions: %H=Hostname, %S=Session Name, %Y=Year, %M=Month, %D=Day, %h=Hour, %m=Min, %s=Sec.&#x0a;Use \n for newline." 
                                           Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="24,4,0,0" />
                            </StackPanel>

                            <!-- Anti-idle Section -->
                            <StackPanel Spacing="8" Margin="0,16,0,0">
                                <TextBlock Text="Anti-idle" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <CheckBox x:Name="AntiIdleCheck" Content="Send string:" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"/>
                                    <TextBox x:Name="AntiIdleStringBox" Width="60" VerticalAlignment="Center" />
                                    <TextBlock Text="every" VerticalAlignment="Center" Margin="4,0,4,0" />

                                    <NumberBox x:Name="AntiIdleIntervalBox" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="10" Width="180" VerticalAlignment="Center" />

                                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Scrollback Buffer Section -->
                            <StackPanel Spacing="8" Margin="0,16,0,0">
                                <TextBlock Text="Scrollback Buffer" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Lines:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <NumberBox x:Name="TermScrollbackBox" SpinButtonPlacementMode="Inline" SmallChange="1000" LargeChange="5000" Width="180" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Startup Command File -->
                            <StackPanel Spacing="8" Margin="0,16,0,0">
                                <TextBlock Text="Startup Command File" FontWeight="SemiBold" />
                                <CheckBox x:Name="StartupCmdCheck" Content="Send file content at login" MinWidth="0" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="StartupCmdPathBox" Grid.Column="0" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=StartupCmdCheck}" />
                                    <Button Content="Browse" Click="BrowseStartupCmd_Click" Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=StartupCmdCheck}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. LOGIN ACTION PAGE -->
                        <StackPanel x:Name="LoginActionPage" Visibility="Collapsed" Padding="16" Spacing="12">
                            <TextBlock Text="Automation / Login Actions" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <ListView x:Name="LoginActionList" Height="180" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                            <TextBlock Text="{Binding Expect}" FontWeight="SemiBold" Width="120"/>
                                            <TextBlock Text="→" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Send}" Width="150"/>
                                            <TextBlock Text="{Binding Timeout}" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add" Click="LoginAction_Add_Click" />
                                <Button Content="Edit" Click="LoginAction_Edit_Click" />
                                <Button Content="Delete" Click="LoginAction_Delete_Click" />
                                <Button Content="Move Up" Click="LoginAction_Up_Click" />
                                <Button Content="Move Down" Click="LoginAction_Down_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. PORT FORWARDING PAGE -->
                        <StackPanel x:Name="PortForwardingPage" Visibility="Collapsed" Padding="16" Spacing="12">
                            <TextBlock Text="Port Forwarding Rules" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <ListView x:Name="PortForwardList" Height="200" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add" Click="PortForward_Add_Click" />
                                <Button Content="Edit" Click="PortForward_Edit_Click" />
                                <Button Content="Delete" Click="PortForward_Delete_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 5. APPEARANCE PAGE -->
                        <StackPanel x:Name="AppearancePage" Spacing="16" Visibility="Collapsed">
                            <Grid RowSpacing="16" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Palette -->
                                <TextBlock Text="Palette:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="PaletteBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="None" IsSelected="True" />
                                    <ComboBoxItem Content="Tango" />
                                    <ComboBoxItem Content="XTerm" />
                                    <ComboBoxItem Content="Rxvt" />
                                </ComboBox>

                                <!-- Color scheme -->
                                <TextBlock Text="Color scheme:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="ColorSchemeBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ColorSchemeBox_SelectionChanged">
                                    <ComboBoxItem Content="Black on light yellow" />
                                    <ComboBoxItem Content="Black on white" />
                                    <ComboBoxItem Content="Gray on black" />
                                    <ComboBoxItem Content="Green on black" />
                                    <ComboBoxItem Content="White on black" />
                                    <ComboBoxItem Content="Custom" />
                                </ComboBox>

                                <!-- Text color -->
                                <TextBlock Text="Text color:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" ToolTipService.ToolTip="Pick color">
                                    <Button.Content>
                                        <Rectangle x:Name="TermFgPreview" Height="32" Fill="Black" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" />
                                    </Button.Content>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="TermFgPicker" ColorChanged="TermFgPicker_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox x:Name="TermFgBox" Visibility="Collapsed" TextChanged="ColorBox_TextChanged" />

                                <!-- Background color -->
                                <TextBlock Text="Background:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" ToolTipService.ToolTip="Pick color">
                                    <Button.Content>
                                        <Rectangle x:Name="TermBgPreview" Height="32" Fill="#FFFFDD" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" />
                                    </Button.Content>
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="TermBgPicker" ColorChanged="TermBgPicker_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox x:Name="TermBgBox" Visibility="Collapsed" TextChanged="ColorBox_TextChanged" />

                                <!-- Font Name and Size -->
                                <TextBlock Text="Font:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="TermFontBox" Grid.Column="0" HorizontalAlignment="Stretch" IsEditable="True" ToolTipService.ToolTip="Select or type a font">
                                        <x:String>Arial</x:String>
                                        <x:String>Bahnschrift</x:String>
                                        <x:String>Calibri</x:String>
                                        <x:String>Cambria</x:String>
                                        <x:String>Cambria Math</x:String>
                                        <x:String>Candara</x:String>
                                        <x:String>Cascadia Code</x:String>
                                        <x:String>Cascadia Mono</x:String>
                                        <x:String>Comic Sans MS</x:String>
                                        <x:String>Consolas</x:String>
                                        <x:String>Constantia</x:String>
                                        <x:String>Corbel</x:String>
                                        <x:String>Courier New</x:String>
                                        <x:String>Ebrima</x:String>
                                        <x:String>Franklin Gothic</x:String>
                                    </ComboBox>
                                    <ComboBox x:Name="TermFontSizeBox" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" ToolTipService.ToolTip="Font Size">
                                        <x:String>8</x:String>
                                        <x:String>9</x:String>
                                        <x:String>10</x:String>
                                        <x:String>11</x:String>
                                        <x:String>12</x:String>
                                        <x:String>14</x:String>
                                        <x:String>16</x:String>
                                        <x:String>18</x:String>
                                        <x:String>20</x:String>
                                        <x:String>22</x:String>
                                        <x:String>24</x:String>
                                        <x:String>26</x:String>
                                        <x:String>28</x:String>
                                        <x:String>36</x:String>
                                        <x:String>48</x:String>
                                        <x:String>72</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- Defaults -->
                                <TextBlock Text="Defaults:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <Button Content="Reset to Defaults" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" Click="ResetAppearance_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- 6. RDP PAGE -->
                        <StackPanel x:Name="RdpPage" Spacing="16" Visibility="Collapsed">
                            <ToggleSwitch x:Name="RdpEnabledSwitch" Header="Enable Remote Desktop (RDP)" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RdpPortBox" Header="Port" Text="3389" Grid.Column="0" />
                                <ComboBox x:Name="RdpResBox" Header="Resolution" HorizontalAlignment="Stretch" Grid.Column="1">
                                    <ComboBoxItem Content="Full Screen" />
                                    <ComboBoxItem Content="1920x1080" />
                                    <ComboBoxItem Content="1280x720" />
                                </ComboBox>
                            </Grid>

                            <StackPanel Spacing="8">
                                <CheckBox x:Name="RdpAudioCheck" Content="Play audio on local computer" MinWidth="0" />
                                <CheckBox x:Name="RdpClipboardCheck" Content="Redirect clipboard" MinWidth="0" />
                                <CheckBox x:Name="RdpCertCheck" Content="Ignore certificate warnings" MinWidth="0" />
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="0,12,0,0">
                                <CheckBox x:Name="RdpDriveCheck" Content="Redirect local drive to remote session" MinWidth="0" />
                                <Grid ColumnSpacing="8" Margin="24,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RdpDrivePathBox" PlaceholderText="C:\" Grid.Column="0" IsEnabled="{Binding IsChecked, ElementName=RdpDriveCheck}" />
                                    <Button Content="Browse" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=RdpDriveCheck}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </NavigationView>

        <!-- New Action Buttons attached to the Window -->
        <Border Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24,16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Save" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click" Width="100"/>
                <Button Content="Cancel" Click="Cancel_Click" Width="100"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>