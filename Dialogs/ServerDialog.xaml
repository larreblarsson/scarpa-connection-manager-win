<Window
    x:Class="scarpa_connection_manager_win.Dialogs.ServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White">
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar & Content -->
        <NavigationView x:Name="NavView" PaneDisplayMode="Left" OpenPaneLength="180" Background="Transparent" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged" Grid.Row="0">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="General" Content="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Terminal" Content="Terminal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="LoginAction" Content="Login Action">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="PortForwarding" Content="Port Forwarding">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Appearance" Content="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="RDP" Content="RDP">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE836;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- NEW: Added Background="Transparent" to this Border -->
            <Border Background="Transparent" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel x:Name="GeneralPage" Spacing="16">
                        <TextBox x:Name="NameBox" Header="Display name" />
                        <ComboBox x:Name="FolderBox" Header="Folder" IsEditable="True" HorizontalAlignment="Stretch" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HostBox" Header="Host / IP" Grid.Column="0" />
                            <TextBox x:Name="PortBox" Header="Port" Text="22" Grid.Column="1" />
                        </Grid>
                        <TextBox x:Name="UserBox" Header="Username" />
                        <ComboBox x:Name="AuthMethodBox" Header="Authentication" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="password" />
                            <ComboBoxItem Content="ask" />
                            <ComboBoxItem Content="key" />
                        </ComboBox>
                        <PasswordBox x:Name="PassBox" Header="Password (stored encrypted in the vault)" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </NavigationView>

        <!-- Bottom Buttons (Unchanged) -->
        <Border Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Cancel" Click="CancelBtn_Click" Width="100" />
                <Button Content="Save" Click="SaveBtn_Click" Style="{StaticResource AccentButtonStyle}" Width="100" />
            </StackPanel>
        </Border>
    </Grid>
</Window>