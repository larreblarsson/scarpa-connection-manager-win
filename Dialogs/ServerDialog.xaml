<ContentDialog
    x:Class="scarpa_connection_manager_win.Dialogs.ServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <Pivot Title="Server Configuration">
        <!-- Basic Settings Tab -->
        <PivotItem Header="Basic">
            <StackPanel Spacing="12" Margin="0,10,0,0">
                <TextBox x:Name="NameBox" Header="Server Name (e.g. Production Web)" />
                <TextBox x:Name="HostBox" Header="Host / IP Address" />
                <TextBox x:Name="PortBox" Header="Port" Text="22" />
                <ComboBox x:Name="FolderBox" Header="Folder" IsEditable="True" HorizontalAlignment="Stretch" />
            </StackPanel>
        </PivotItem>

        <!-- Authentication Tab -->
        <PivotItem Header="Authentication">
            <StackPanel Spacing="12" Margin="0,10,0,0">
                <TextBox x:Name="UserBox" Header="Username" />
                <ComboBox x:Name="AuthMethodBox" Header="Authentication Method" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="password" />
                    <ComboBoxItem Content="ask" />
                    <ComboBoxItem Content="key" />
                </ComboBox>
                <PasswordBox x:Name="PassBox" Header="Password / Passphrase" />
            </StackPanel>
        </PivotItem>

        <!-- Advanced Tab -->
        <PivotItem Header="Advanced">
            <StackPanel Spacing="12" Margin="0,10,0,0">
                <CheckBox x:Name="RdpEnabledCheck" Content="Enable Remote Desktop (RDP) for this server" />
            </StackPanel>
        </PivotItem>
    </Pivot>
</ContentDialog>