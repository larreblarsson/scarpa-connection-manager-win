<ui:FluentWindow x:Class="ScarpaConnectionManager.Dialogs.ServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Server Configuration" Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">
    
    <DockPanel LastChildFill="True">
        <ui:TitleBar Title="Server Configuration" DockPanel.Dock="Top" />

        <DockPanel Margin="14">
            <!-- Bottom Action Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" Width="80" Appearance="Secondary" />
                <ui:Button Content="Save" IsDefault="True" Click="Save_Click" Width="80" Appearance="Primary" />
            </StackPanel>

            <!-- Edge-Style Left/Right Layout -->
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="1" /> <!-- Divider Line -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Navigation Menu -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                <StackPanel IsItemsHost="True" />
                            </ScrollViewer>
                            
                            <!-- Subtle Divider -->
                            <Border Grid.Column="1" Background="#E5E5E5" Margin="0,5,0,5" />
                            
                            <!-- Right Content Pane -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="20,0,10,0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Padding" Value="12,10"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- 1. GENERAL -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="General" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel>
                        <Label Content="Display name" />
                        <ui:TextBox x:Name="NameBox" ClearButtonEnabled="True" />
                        <Label Content="Folder" Margin="0,8,0,0" />
                        <ComboBox x:Name="FolderBox" IsEditable="True" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Label Content="Host / IP" />
                                <ui:TextBox x:Name="HostBox" ClearButtonEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Port" />
                                <ui:TextBox x:Name="PortBox" Text="22" ClearButtonEnabled="True" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Username" Margin="0,8,0,0" />
                        <ui:TextBox x:Name="UserBox" ClearButtonEnabled="True" />

                        <Label Content="Authentication" Margin="0,8,0,0" />
                        <ComboBox x:Name="AuthBox" SelectionChanged="Auth_Changed">
                            <ComboBoxItem Content="Password" Tag="password" />
                            <ComboBoxItem Content="Private key file" Tag="key_file" />
                            <ComboBoxItem Content="Ask every time" Tag="ask" />
                        </ComboBox>

                        <StackPanel x:Name="PasswordPanel">
                            <Label Content="Password (stored encrypted in the vault)" Margin="0,8,0,0" />
                            <ui:PasswordBox x:Name="PassBox" />
                        </StackPanel>

                        <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                            <Label Content="Private key file" Margin="0,8,0,0" />
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseKey_Click" Margin="8,0,0,0" Appearance="Secondary" />
                                <ui:TextBox x:Name="KeyBox" ClearButtonEnabled="True" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- 2. TERMINAL -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE756;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Terminal" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel>
                        <GroupBox Header="Session logging" Margin="0,0,0,12">
                            <StackPanel Margin="0,5,0,0">
                                <CheckBox x:Name="LogEnabled" Content="Record this session to a log file" />
                                <Label Content="Log path  (%N name, %H host, %U user, %Y %M %D %h %m %s date)" Margin="0,8,0,0" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseLog_Click" Margin="8,0,0,0" Appearance="Secondary" />
                                    <ui:TextBox x:Name="LogPathBox" ClearButtonEnabled="True" />
                                </DockPanel>
                                <ComboBox x:Name="LogModeBox" Margin="0,8,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Overwrite" Tag="overwrite" />
                                    <ComboBoxItem Content="Append" Tag="append" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Keep alive">
                            <StackPanel Margin="0,5,0,0">
                                <CheckBox x:Name="AntiIdleEnabled" Content="Send keep-alive packets" />
                                <Label Content="Interval (seconds)" Margin="0,8,0,0" />
                                <ui:TextBox x:Name="AntiIdleInterval" Text="60" ClearButtonEnabled="True" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <!-- 3. LOGIN ACTION -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D7;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Login Action" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                                   Text="Post-login steps: wait for a prompt pattern, then send text. Runs after the SSH session is established."
                                   Margin="0,0,0,8" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SeqExpect" Grid.Column="0" Margin="0,0,6,0" ToolTip="Expect pattern" ClearButtonEnabled="True" />
                            <ui:TextBox x:Name="SeqSend" Grid.Column="1" Margin="0,0,6,0" ToolTip="Send text" ClearButtonEnabled="True" />
                            <ui:TextBox x:Name="SeqDelay" Grid.Column="2" Text="0" ToolTip="Delay (s)" ClearButtonEnabled="True" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Add step" Click="AddStep_Click" Margin="0,0,8,0" Appearance="Secondary" />
                            <ui:Button Content="Remove" Click="RemoveStep_Click" Margin="0,0,8,0" Appearance="Secondary" />
                            <ui:Button Content="Up" Click="StepUp_Click" Margin="0,0,8,0" Appearance="Secondary" />
                            <ui:Button Content="Down" Click="StepDown_Click" Appearance="Secondary" />
                        </StackPanel>
                        <ListBox x:Name="StepList" Background="Transparent" />
                    </DockPanel>
                </TabItem>

                <!-- 4. PORT FORWARDING -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8DF;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Port Forwarding" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Add" Click="AddForward_Click" Margin="0,0,8,0" Appearance="Secondary" />
                            <ui:Button Content="Remove" Click="RemoveForward_Click" Appearance="Secondary" />
                        </StackPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="FwdType" Grid.Column="0" Margin="0,0,6,0" SelectedIndex="0">
                                <ComboBoxItem Content="Local" />
                                <ComboBoxItem Content="Remote" />
                                <ComboBoxItem Content="Dynamic" />
                            </ComboBox>
                            <ui:TextBox x:Name="FwdSrc" Grid.Column="1" Margin="0,0,6,0" ToolTip="Source port" ClearButtonEnabled="True" />
                            <ui:TextBox x:Name="FwdHost" Grid.Column="2" Margin="0,0,6,0" ToolTip="Destination host" ClearButtonEnabled="True" />
                            <ui:TextBox x:Name="FwdDest" Grid.Column="3" ToolTip="Destination port" ClearButtonEnabled="True" />
                        </Grid>
                        <ListBox x:Name="ForwardList" Background="Transparent" />
                    </DockPanel>
                </TabItem>

                <!-- 5. APPEARANCE -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Appearance" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel>
                        <Label Content="Font (family and size)" />
                        <ui:TextBox x:Name="FontBox" ClearButtonEnabled="True" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <Label Content="Foreground (#RRGGBB)" />
                                <ui:TextBox x:Name="FgBox" ClearButtonEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Background (#RRGGBB)" />
                                <ui:TextBox x:Name="BgBox" ClearButtonEnabled="True" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Scrollback lines" Margin="0,8,0,0" />
                        <ui:TextBox x:Name="ScrollbackBox" ClearButtonEnabled="True" />
                    </StackPanel>
                </TabItem>

                <!-- 6. RDP -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="RDP" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel>
                        <CheckBox x:Name="RdpEnabled" Content="Enable Remote Desktop for this host" />
                        <Label Content="RDP port" Margin="0,8,0,0" />
                        <ui:TextBox x:Name="RdpPortBox" Text="3389" ClearButtonEnabled="True" />
                        <Label Content="Resolution" Margin="0,8,0,0" />
                        <ComboBox x:Name="RdpResBox" IsEditable="True">
                            <ComboBoxItem Content="Full Screen" />
                            <ComboBoxItem Content="1920x1080" />
                            <ComboBoxItem Content="1600x900" />
                            <ComboBoxItem Content="1366x768" />
                            <ComboBoxItem Content="1280x720" />
                        </ComboBox>
                        <CheckBox x:Name="RdpAudio" Content="Redirect audio to this computer" Margin="0,12,0,0" />
                        <CheckBox x:Name="RdpClipboard" Content="Share clipboard" Margin="0,6,0,0" />
                        <CheckBox x:Name="RdpCert" Content="Ignore certificate warnings" Margin="0,6,0,0" />
                        <CheckBox x:Name="RdpDrive" Content="Redirect local drives" Margin="0,6,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</ui:FluentWindow>