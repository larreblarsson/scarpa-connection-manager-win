<Window
    x:Class="scarpa_connection_manager_win.Dialogs.SftpWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:scarpa_connection_manager_win.Dialogs">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Global Keyboard Accelerators -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F2" Invoked="F2_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="CtrlC_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="X" Invoked="CtrlX_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="CtrlV_Invoked" />
            <KeyboardAccelerator Key="Delete" Invoked="DeleteKey_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- The Modern Windows 11 Context Menu -->
        <Grid.Resources>
            <!-- Reverted back to the native WinUI 3 CommandBarFlyout -->
            <CommandBarFlyout x:Name="FileContextMenu">
                <CommandBarFlyout.PrimaryCommands>
                    <AppBarButton Icon="Cut" Label="Cut" Click="ContextCut_Click" />
                    <AppBarButton Icon="Copy" Label="Copy" Click="ContextCopy_Click" />
                    <AppBarButton Icon="Paste" Label="Paste" Click="ContextPaste_Click" />
                    <AppBarButton Icon="Rename" Label="Rename" Click="ContextRename_Click" />
                    <AppBarButton Icon="Delete" Label="Delete" Click="ContextDelete_Click" />
                    <!-- Removed the Resume button so Calculate Size fits without the three dots -->
                    <AppBarButton Icon="Calculator" Label="Calculate Size" Click="ContextCalculateSize_Click" />
                </CommandBarFlyout.PrimaryCommands>
            </CommandBarFlyout>

            <MenuFlyout x:Name="HeaderContextMenu">
                <MenuFlyoutItem Text="Size All Columns to Fit" IsEnabled="False" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem Text="Name" IsChecked="True" IsEnabled="False" />
                <ToggleMenuFlyoutItem x:Name="MenuToggleDate" Text="Date modified" IsChecked="True" Click="ToggleColumn_Click" />
                <ToggleMenuFlyoutItem x:Name="MenuToggleType" Text="Type" IsChecked="True" Click="ToggleColumn_Click" />
                <ToggleMenuFlyoutItem x:Name="MenuToggleSize" Text="Size" IsChecked="True" Click="ToggleColumn_Click" />
            </MenuFlyout>
        </Grid.Resources>

        <!-- Tightened outer padding to reduce the side/top white space -->
        <Grid Padding="10,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#F8F8F8" CornerRadius="6" Margin="0,0,0,6">
                <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarButton Icon="Upload" Label="Upload" Click="Upload_Click" ToolTipService.ToolTip="Upload selected local files to remote server"/>
                    <AppBarButton Icon="Download" Label="Download" Click="Download_Click" ToolTipService.ToolTip="Download selected remote files to local machine"/>
                    <AppBarButton Icon="Play" Label="Resume" Click="Resume_Click" ToolTipService.ToolTip="Resume an interrupted file transfer"/>
                    <AppBarSeparator/>
                    <AppBarButton Icon="Add" Label="New Folder" Click="NewFolder_Click" ToolTipService.ToolTip="Create a new folder"/>
                    <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click" ToolTipService.ToolTip="Delete selected items"/>
                    <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click"/>
                </CommandBar>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Local Files -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10" Background="#F8F8F8" Padding="6" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Local: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        <Border Grid.Column="1" BorderThickness="0" CornerRadius="4" HorizontalAlignment="Stretch" MinHeight="32" Tapped="LocalAddressBar_Tapped" Background="White">
                            <Grid>
                                <StackPanel x:Name="LocalPathContainer" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,5,0" />
                                <TextBox x:Name="LocalPathInput" Visibility="Collapsed" VerticalAlignment="Center" Margin="0" BorderThickness="0" Background="Transparent" KeyDown="LocalPathInput_KeyDown" LostFocus="LocalPathInput_LostFocus" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ListView x:Name="LocalFileList" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" 
                        SelectionChanged="FileList_SelectionChanged"
                        DoubleTapped="LocalFileList_DoubleTapped" SelectionMode="Extended"
                        GotFocus="LocalFileList_GotFocus" PointerPressed="LocalFileList_PointerPressed"
                        RightTapped="FileList_RightTapped" Tapped="FileList_Tapped"
                        PreviewKeyDown="FileList_PreviewKeyDown" 
                        CanDragItems="True" AllowDrop="True" 
                        DragItemsStarting="FileList_DragItemsStarting" DragOver="FileList_DragOver" Drop="FileList_Drop" DragLeave="FileList_DragLeave">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.Header>
                            <Grid Padding="5,5,0,5" BorderBrush="LightGray" BorderThickness="0,0,0,1" Background="Transparent" RightTapped="Header_RightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalNameColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalDateColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalTypeColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalSizeColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock Text="Name" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="LocalName">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="LocalName" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                                <Grid Grid.Column="1" x:Name="LocalHeaderDate">
                                    <TextBlock Text="Date modified" FontWeight="SemiBold" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="LocalDate">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="LocalDate" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                                <Grid Grid.Column="2" x:Name="LocalHeaderType">
                                    <TextBlock Text="Type" FontWeight="SemiBold" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="LocalType">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="LocalType" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                                <Grid Grid.Column="3" x:Name="LocalHeaderSize">
                                    <TextBlock Text="Size" FontWeight="SemiBold" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="LocalSize">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="LocalSize" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" Padding="5,5,0,5" Background="{Binding DropBackgroundBrush, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalNameColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalDateColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalTypeColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=LocalSizeColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <FontIcon Glyph="{Binding Icon}" Margin="0,0,10,0" Foreground="{Binding IconColor}"/>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" Visibility="{Binding TextVisibility, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBox Text="{Binding Name, Mode=OneWay}" Visibility="{Binding EditVisibility, Mode=OneWay}" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" MinWidth="150" Margin="-8,-4,0,-4" Padding="4,2,4,2"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding DateVisibility, Mode=OneWay}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding TypeVisibility, Mode=OneWay}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding SizeVisibility, Mode=OneWay}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Thin, light gray vertical separator matching Windows 11 style -->
                <Border Grid.Column="1" Width="1" Background="#E5E5E5" Margin="10,80,10,15" />

                <!-- Right Pane: Remote Files -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10" Background="#F8F8F8" Padding="6" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Remote: " FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        <Border Grid.Column="1" BorderThickness="0" CornerRadius="4" HorizontalAlignment="Stretch" MinHeight="32" Tapped="RemoteAddressBar_Tapped" Background="White">
                            <Grid>
                                <StackPanel x:Name="RemotePathContainer" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,5,0" />
                                <TextBox x:Name="RemotePathInput" Visibility="Collapsed" VerticalAlignment="Center" Margin="0" BorderThickness="0" Background="Transparent" KeyDown="RemotePathInput_KeyDown" LostFocus="RemotePathInput_LostFocus" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ListView x:Name="RemoteFileList" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" 
                        SelectionChanged="FileList_SelectionChanged"
                        DoubleTapped="RemoteFileList_DoubleTapped" SelectionMode="Extended"
                        GotFocus="RemoteFileList_GotFocus" PointerPressed="RemoteFileList_PointerPressed"
                        RightTapped="FileList_RightTapped" Tapped="FileList_Tapped"
                        PreviewKeyDown="FileList_PreviewKeyDown" 
                        CanDragItems="True" AllowDrop="True" 
                        DragItemsStarting="FileList_DragItemsStarting" DragOver="FileList_DragOver" Drop="FileList_Drop" DragLeave="FileList_DragLeave">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.Header>
                            <Grid Padding="5,5,0,5" BorderBrush="LightGray" BorderThickness="0,0,0,1" Background="Transparent" RightTapped="Header_RightTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteNameColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteDateColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteTypeColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteSizeColGridLength, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock Text="Name" FontWeight="SemiBold" Foreground="Gray" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="RemoteName">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="RemoteName" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                                <Grid Grid.Column="1" x:Name="RemoteHeaderDate">
                                    <TextBlock Text="Date modified" FontWeight="SemiBold" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="RemoteDate">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="RemoteDate" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                                <Grid Grid.Column="2" x:Name="RemoteHeaderType">
                                    <TextBlock Text="Type" FontWeight="SemiBold" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="RemoteType">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="RemoteType" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                                <Grid Grid.Column="3" x:Name="RemoteHeaderSize">
                                    <TextBlock Text="Size" FontWeight="SemiBold" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <local:SplitterContainer Width="12" HorizontalAlignment="Right" Margin="0,0,-6,0" Canvas.ZIndex="10" Background="Transparent" DoubleTapped="ColumnSplitter_DoubleTapped" Tag="RemoteSize">
                                        <Border Width="1" Background="#DDDDDD" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,4"/>
                                        <Thumb HorizontalAlignment="Stretch" DragDelta="ColumnSplitter_DragDelta" Tag="RemoteSize" Opacity="0" />
                                    </local:SplitterContainer>
                                </Grid>
                            </Grid>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" Padding="5,5,0,5" Background="{Binding DropBackgroundBrush, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteNameColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteDateColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteTypeColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="{Binding ElementName=RootWindow, Path=RemoteSizeColGridLength, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <FontIcon Glyph="{Binding Icon}" Margin="0,0,10,0" Foreground="{Binding IconColor}"/>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" Visibility="{Binding TextVisibility, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBox Text="{Binding Name, Mode=OneWay}" Visibility="{Binding EditVisibility, Mode=OneWay}" KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus" MinWidth="150" Margin="-8,-4,0,-4" Padding="4,2,4,2"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding DateVisibility, Mode=OneWay}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding TypeVisibility, Mode=OneWay}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding SizeVisibility, Mode=OneWay}" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <!-- Loading Overlay for File Transfers -->
        <Grid x:Name="ProgressOverlay" Background="#80000000" Visibility="Collapsed" Canvas.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="30" CornerRadius="8">
                <ProgressRing IsActive="True" Width="50" Height="50" Margin="0,0,0,10"/>
                <TextBlock x:Name="ProgressText" Text="Transferring..." HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>