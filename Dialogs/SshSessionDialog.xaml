<Window
    x:Class="scarpa_connection_manager_win.Dialogs.SshSessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/scarpa_icon.ico" Width="16" Height="16" Margin="10,0,10,0" VerticalAlignment="Center"/>

            <TextBlock x:Name="AppTitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,0"/>

            <!-- Edit Settings Button -->
            <Button x:Name="EditConfigBtn" Grid.Column="2" Content="&#xE713;" 
                    FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" 
                    Width="40" Height="32" Click="EditConfigBtn_Click" 
                    ToolTipService.ToolTip="Edit Session Settings"/>

            <!-- System Buttons Padding (Minimize, Maximize, Close) -->
            <Grid x:Name="RightPaddingGrid" Grid.Column="3"/>
        </Grid>

        <!-- Terminal Container -->
        <Grid x:Name="TerminalGrid" Grid.Row="1"/>
    </Grid>
</Window>