<Window
    x:Class="scarpa_connection_manager_win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:scarpa_connection_manager_win">

    <Grid Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="115"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutSubItem Text="Import">
                    <MenuFlyoutItem Text="Scarpa JSON…" Click="ImportScarpa_Click" />
                    <MenuFlyoutItem Text="PuTTY (this computer)" Click="ImportPuttyRegistry_Click" />
                    <MenuFlyoutItem Text="PuTTY .reg file…" Click="ImportPuttyFile_Click" />
                    <MenuFlyoutItem Text="SecureCRT XML…" Click="ImportSecureCrt_Click" />
                    <MenuFlyoutItem Text="MobaXterm sessions…" Click="ImportMoba_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Export vault (plain JSON)…" Click="Export_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Change master passphrase…" Click="ChangePassphrase_Click" />
                <MenuFlyoutItem Text="Forget saved passphrase" Click="ForgetPassphrase_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Servers">
                <MenuFlyoutItem Text="Add…" Click="AddServer_Click" />
                <MenuFlyoutItem Text="Edit…" Click="EditServer_Click" />
                <MenuFlyoutItem Text="Delete" Click="DeleteSelected_Click" />
                <MenuFlyoutItem Text="Copy" Click="Duplicate_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Folders">
                <MenuFlyoutItem Text="Add…" Click="NewFolder_Click" />
                <MenuFlyoutItem Text="Delete" Click="DeleteSelected_Click" />
                <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Connect">
                <MenuFlyoutItem Text="SSH" Click="Ssh_Click" />
                <MenuFlyoutItem Text="SFTP" Click="SftpCli_Click" />
                <MenuFlyoutItem Text="SFTP GUI" Click="SftpGui_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Tree View -->
        <TreeView x:Name="Tree" Grid.Row="1" 
                  DoubleTapped="Tree_DoubleClick"
                  Tapped="Tree_Tapped"
                  RightTapped="Tree_RightTapped"
                  KeyDown="Tree_KeyDown" 
                  ItemInvoked="Tree_ItemInvoked"
                  AllowDrop="True" 
                  CanDragItems="True" 
                  CanReorderItems="True" 
                  DragItemsCompleted="Tree_DragItemsCompleted">
            <TreeView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="32">
                        <FontIcon Glyph="{Binding Content.IconGlyph}" Foreground="{Binding Content.IconColor}" VerticalAlignment="Center"/>

                        <!-- Standard View -->
                        <TextBlock Text="{Binding Content.Name}" 
                       Visibility="{Binding Content.ReadVisibility}" 
                       VerticalAlignment="Center"/>

                        <!-- Inline Edit View -->
                        <TextBox Text="{Binding Content.Name}" 
                     Visibility="{Binding Content.EditVisibility}"
                     Loaded="RenameTextBox_Loaded"
                     KeyDown="RenameTextBox_KeyDown"
                     LostFocus="RenameTextBox_LostFocus"
                     MinHeight="24" Padding="4,2" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TreeView.ItemTemplate>

            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="SSH" Click="Ssh_Click" />
                    <MenuFlyoutItem Text="SFTP" Click="SftpCli_Click" />
                    <MenuFlyoutItem Text="SFTP GUI" Click="SftpGui_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Edit…" Click="EditServer_Click" />
                    <MenuFlyoutItem Text="Duplicate" Click="Duplicate_Click" />
                    <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
                    <MenuFlyoutItem Text="Delete" Click="DeleteSelected_Click" />
                    <MenuFlyoutItem Text="Add Folder" Click="ContextMenu_AddFolder_Click" />
                    <MenuFlyoutItem Text="Add Server" Click="ContextMenu_AddServer_Click" />
                </MenuFlyout>
            </TreeView.ContextFlyout>
        </TreeView>

        <!-- Log Box -->
        <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0,1,0,0" Background="Transparent" />
    </Grid>
</Window>