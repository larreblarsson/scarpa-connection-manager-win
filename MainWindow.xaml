<Window
    x:Class="scarpa_connection_manager_win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:scarpa_connection_manager_win">

    <Grid Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="115"/>
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutSubItem Text="Import">
                    <MenuFlyoutItem Text="Scarpa JSON…" Click="ImportScarpa_Click" />
                    <MenuFlyoutItem Text="PuTTY (this computer)" Click="ImportPuttyRegistry_Click" />
                    <MenuFlyoutItem Text="PuTTY .reg file…" Click="ImportPuttyFile_Click" />
                    <MenuFlyoutItem Text="SecureCRT XML…" Click="ImportSecureCrt_Click" />
                    <MenuFlyoutItem Text="MobaXterm sessions…" Click="ImportMoba_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Export vault (plain JSON)…" Click="Export_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Change master passphrase…" Click="ChangePassphrase_Click" />
                <MenuFlyoutItem Text="Forget saved passphrase" Click="ForgetPassphrase_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Servers">
                <MenuFlyoutItem Text="Add…" Click="AddServer_Click" />
                <MenuFlyoutItem Text="Edit…" Click="EditServer_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
                <MenuFlyoutItem Text="Cut" Click="Cut_Click" />
                <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete" Click="DeleteSelected_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Folders">
                <MenuFlyoutItem Text="Add…" Click="NewFolder_Click" />
                <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
                <MenuFlyoutItem Text="Cut" Click="Cut_Click" />
                <MenuFlyoutItem Text="Paste" Click="Paste_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete" Click="DeleteSelected_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Connect">
                <MenuFlyoutItem Text="SSH" Click="Ssh_Click" />
                <MenuFlyoutItem Text="SFTP" Click="SftpCli_Click" />
                <MenuFlyoutItem Text="SFTP GUI" Click="SftpGui_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Tree View (SelectionMode="None" so we handle custom classic selection) -->
        <TreeView x:Name="Tree" Grid.Row="1" 
                  SelectionMode="None"
                  DoubleTapped="Tree_DoubleClick"
                  Tapped="Tree_Tapped"
                  RightTapped="Tree_RightTapped"
                  KeyDown="Tree_KeyDown" 
                  ItemInvoked="Tree_ItemInvoked"
                  AllowDrop="True" 
                  CanDragItems="True" 
                  CanReorderItems="True" 
                  DragItemsCompleted="Tree_DragItemsCompleted">
            <TreeView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{Binding Content.BackgroundBrush}" CornerRadius="4" Margin="0,2">

                        <!-- Windows 11 Blue Selection Indicator -->
                        <Rectangle Width="3" Height="16" Fill="#0078D4" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                                   RadiusX="1.5" RadiusY="1.5"
                                   Visibility="{Binding Content.IndicatorVisibility}" />

                        <!-- Main Content (Padding updated to clear the blue line) -->
                        <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="32" Padding="12,0,8,0">
                            <FontIcon Glyph="{Binding Content.IconGlyph}" Foreground="{Binding Content.IconColor}" VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding Content.Name}" 
                                       Visibility="{Binding Content.ReadVisibility}" 
                                       VerticalAlignment="Center"/>

                            <TextBox Text="{Binding Content.Name, Mode=TwoWay}" 
                                     Visibility="{Binding Content.EditVisibility}"
                                     Loaded="RenameTextBox_Loaded"
                                     KeyDown="RenameTextBox_KeyDown"
                                     LostFocus="RenameTextBox_LostFocus"
                                     MinHeight="24" Padding="4,2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </TreeView.ItemTemplate>

            <!-- Native Windows 11 Style Context Menu -->
            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem>
                        <MenuFlyoutItem.Template>
                            <ControlTemplate TargetType="MenuFlyoutItem">
                                <Grid Background="Transparent" Padding="4,4,4,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <StackPanel.Resources>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        </StackPanel.Resources>

                                        <Button Click="Cut_Click" Width="60" Padding="0,6" CornerRadius="4" ToolTipService.ToolTip="Cut">
                                            <StackPanel Spacing="3">
                                                <FontIcon Glyph="&#xE8C6;" FontSize="16" Foreground="#0078D4" />
                                                <TextBlock Text="Cut" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,8" />

                                        <Button Click="Copy_Click" Width="60" Padding="0,6" CornerRadius="4" ToolTipService.ToolTip="Copy">
                                            <StackPanel Spacing="3">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#0078D4" />
                                                <TextBlock Text="Copy" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,8" />

                                        <Button Click="Paste_Click" Width="60" Padding="0,6" CornerRadius="4" ToolTipService.ToolTip="Paste">
                                            <StackPanel Spacing="3">
                                                <FontIcon Glyph="&#xE77F;" FontSize="16" Foreground="#0078D4" />
                                                <TextBlock Text="Paste" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,8" />

                                        <Button Click="Rename_Click" Width="60" Padding="0,6" CornerRadius="4" ToolTipService.ToolTip="Rename">
                                            <StackPanel Spacing="3">
                                                <FontIcon Glyph="&#xE8AC;" FontSize="16" Foreground="#0078D4" />
                                                <TextBlock Text="Rename" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,8" />

                                        <Button Click="DeleteSelected_Click" Width="60" Padding="0,6" CornerRadius="4" ToolTipService.ToolTip="Delete">
                                            <StackPanel Spacing="3">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                <TextBlock Text="Delete" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </MenuFlyoutItem.Template>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="SSH" Click="Ssh_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE756;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="SFTP" Click="SftpCli_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE83B;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="SFTP GUI" Click="SftpGui_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7B4;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Edit…" Click="EditServer_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Add Folder" Click="ContextMenu_AddFolder_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8F4;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="Add Server" Click="ContextMenu_AddServer_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                </MenuFlyout>
            </TreeView.ContextFlyout>
        </TreeView>

        <!-- Log Box -->
        <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0,1,0,0" Background="Transparent" />
    </Grid>
</Window>