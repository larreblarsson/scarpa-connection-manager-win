<Window x:Class="ScarpaConnectionManager.Views.SftpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SFTP" Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="Progress" Width="220" Height="12" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LOCAL -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Local"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Go" Click="LocalGo_Click" />
                    <Button DockPanel.Dock="Right" Content="Up" Click="LocalUp_Click" />
                    <TextBox x:Name="LocalPath" KeyDown="LocalPath_KeyDown" />
                </DockPanel>
                <ListView x:Name="LocalList" MouseDoubleClick="LocalList_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8">
                <Button Content="Upload  →" Click="Upload_Click" Margin="0,4" />
                <Button Content="←  Download" Click="Download_Click" Margin="0,4" />
                <Separator Margin="0,10" />
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,4" />
                <Button Content="New folder" Click="NewFolder_Click" Margin="0,4" />
                <Button Content="Rename" Click="Rename_Click" Margin="0,4" />
                <Button Content="Delete" Click="Delete_Click" Margin="0,4" />
            </StackPanel>

            <!-- REMOTE -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" x:Name="RemoteTitle" Text="Remote"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Go" Click="RemoteGo_Click" />
                    <Button DockPanel.Dock="Right" Content="Up" Click="RemoteUp_Click" />
                    <TextBox x:Name="RemotePath" KeyDown="RemotePath_KeyDown" />
                </DockPanel>
                <ListView x:Name="RemoteList" MouseDoubleClick="RemoteList_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                            <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>